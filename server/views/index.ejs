<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <div class="dashboard-container">
    <!-- Header Area -->
    <div class="dashboard-header">
      <h1><%= title %></h1>
      <a href="/create" class="btn btn-create">+ Create a User</a>
    </div>

    <!-- User List Section -->
    <ul class="user-list">
      <% if (locals.users) {%>
        <% users.forEach(user => { %>
          <li class="user-item">
            
            <!-- User Information Display -->
            <div class="user-info">
              <span class="user-id">ID: <%= user.id %></span>
              <span class="user-name"><%= user.firstName %> <%= user.lastName %></span>
            </div>
            
            <!-- Action Buttons -->
            <div class="action-group">
              <a href="/<%= user.id %>/update" class="btn btn-update">Update</a>
              
              <!-- This time we're sending a POST request to our route, so we need a form. -->
              <form action="/<%= user.id %>/delete" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-delete" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
              </form>
            </div>

          </li>
        <% }); %>
      <% } %>
    </ul>
  </div>

</body>
</html>