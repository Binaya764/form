<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/createstyle.css">
</head>
<body>

  <div class="form-wrapper">
    <div class="form-card">
      <h1><%= title %></h1>
      
      <!-- Error Display Area -->
      <div class="error-wrapper">
        <%- include("partials/errors.ejs") %>
      </div>
      
      <form action="/<%= user.id %>/update" method="POST">
        <!-- First Name Field -->
        <div class="form-group">
          <label for="firstName">First Name</label>
          <input type="text" name="firstName" id="firstName" value="<%= user.firstName %>" required>
        </div>
        
        <!-- Last Name Field -->
        <div class="form-group">
          <label for="lastName">Last Name</label>
          <input type="text" name="lastName" id="lastName" value="<%= user.lastName %>" required>
        </div>
        
        <!-- Action Button -->
        <button type="submit" class="btn-submit">Update User</button>
      </form>
      
      <a href="/" class="link-back">← Back to home</a>
    </div>
  </div>

</body>
</html>